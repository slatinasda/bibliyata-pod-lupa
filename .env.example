# ── Database ──────────────────────────────────────────────────
# Postgres connection string. On Railway add a PostgreSQL database and reference its URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/bibliyata_pod_lupa"

# "true" when the host requires SSL for Postgres (not needed for Railway's internal URL).
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────────
# Long random string that signs admin login tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Admin account, created/updated on every start (and by `npm run seed:admin`).
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Optional two-factor for the admin panel. Generate with `npm run totp`,
# add the secret to an authenticator app, then set it here.
# ADMIN_TOTP_SECRET=

# ── Email notifications (optional) ────────────────────────────
# Without these, submissions are still saved and shown in /admin, just without an email.
# Sent through ZeptoMail's REST API (src/email.js).
# ZEPTOMAIL_TOKEN=
# NOTIFY_FROM=noreply@example.com
# NOTIFY_TO=you@example.com

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. The site and the API share
# one origin, so this can stay empty (same-origin requests do not need CORS).
ALLOWED_ORIGINS=

# ── Server ────────────────────────────────────────────────────
PORT=3000
